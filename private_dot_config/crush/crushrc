# Crush config — mirrors the Goose->Bifrost LLM setup on pluto.
# Bifrost (OpenAI-compatible gateway) at :8080 routes by virtual key.
# The vk 'vk-goose' maps to the coding fallback chain (laguna-s-2.1 -> nemotron-ultra -> laguna-xs).

# openai-compat (NOT openai): bifrost is an OpenAI-compatible gateway, not OpenAI itself.
provider add bifrost --type openai-compat \
  --base-url "http://localhost:8080/v1" \
  --api-key "$(podman secret inspect vk_goose --showsecret --format '{{.SecretData}}')"

# Model id is a label; actual routing is decided by the vk in Bifrost.
# Routing is decided by the vk in Bifrost; this id is just a label.
model add bifrost/default \
  --name "Bifrost (routed by vk)" \
  --context-window 128000 \
  --default-max-tokens 8000

# Free models via OpenRouter can be slow; be patient on first token.
option debug false

# Default model slots -> bifrost (otherwise crush auto-selects gemini).
# The id is a label; Bifrost routes by the vk to the coding chain.
model large bifrost/default
model small bifrost/default

# Bifrost is the single source of truth; do not pull the Catwalk catalog.
option provider-auto-update false
